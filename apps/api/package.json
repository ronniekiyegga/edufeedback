{
  "name": "@attainline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test tests/readiness.test.ts tests/database-errors.test.ts tests/student-cursor.test.ts tests/students.routes.test.ts",
    "test:integration": "prisma generate && tsx --test --test-concurrency=1 tests/student-constraints.integration.test.ts tests/students.integration.test.ts",
    "seed:demo": "prisma generate && tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "prisma": "7.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
